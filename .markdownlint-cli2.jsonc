{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "globs": [
    "content/**/*.md",
    "README.md"
  ],
  "customRules": [],
  "config": {
    "default": true,
    "MD004": false,
    "MD009": false,
    "MD010": false,
    "MD012": false,
    "MD013": false,
    "MD034": false,
    "MD033": false,
    "MD041": false,
    "MD047": false
  }
}
